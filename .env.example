# Copy to .env and fill in. The default provider is "mock": everything —
# demo, tests, evals — runs offline with NO keys at all.
NOTULA_PROVIDER=mock

# Required only for NOTULA_PROVIDER=live:
# Pass 1 (audio -> transcript): Gemini multimodal.
GEMINI_API_KEY=
# Pass 2 (transcript -> summary): DeepSeek, OpenAI-compatible endpoint.
DEEPSEEK_API_KEY=
